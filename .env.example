# Used by docker-compose.yml when running `docker compose up`.
# Copy to .env in this same directory (project root) and fill in real values.
# Docker Compose auto-loads a .env file from the project root - no need to export manually.

JWT_SECRET=replace_with_output_of__openssl_rand_base64_64
DB_PASSWORD=changeme

# Host-side ports - defaults chosen to avoid colliding with other local projects.
# Change these if they still collide with something already running on your machine.
DB_HOST_PORT=5434
BACKEND_HOST_PORT=8081
FRONTEND_HOST_PORT=5175

CORS_ALLOWED_ORIGINS=http://localhost:5175
FRONTEND_BASE_URL=http://localhost:5175

AI_PROVIDER=none
AI_API_KEY=

PAYMENT_PROVIDER=none
PAYMENT_WEBHOOK_SECRET=

EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
