# Copy to .env and fill in real values. Never commit the real .env file.

# Database
DB_URL=jdbc:postgresql://localhost:5432/resumeai
DB_USERNAME=resumeai
DB_PASSWORD=change_me

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_secret_at_least_512_bits
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# CORS — comma separated, no wildcard in production
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Only set to true if this app sits behind a trusted reverse proxy that sets X-Forwarded-For.
# Leave false otherwise — trusting this header from untrusted clients allows rate-limit bypass.
TRUST_PROXY_HEADERS=false

# Uploads
MAX_FILE_SIZE_MB=10
STORAGE_DIR=./storage/resumes
RESUME_RETENTION_DAYS=365

# AI provider (Phase 3+). Leave AI_PROVIDER=none to run without AI-powered bullet rewriting.
AI_PROVIDER=none
AI_API_KEY=
AI_TIMEOUT_MS=15000

# Payments (Phase 5). Leave PAYMENT_PROVIDER=none unless you've actually set up Stripe.
PAYMENT_PROVIDER=none
PAYMENT_WEBHOOK_SECRET=

# Frontend URL used in generated email links (verification/reset).
FRONTEND_BASE_URL=http://localhost:5175

# Email (verification + password reset). Leave EMAIL_PROVIDER=none to have emails logged
# to the backend console instead of actually sent - useful for local dev without SMTP.
EMAIL_PROVIDER=none
EMAIL_FROM_ADDRESS=noreply@resumeai.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# OCR for image-only PDFs. Leave OCR_PROVIDER=none unless Tesseract is actually installed
# on this machine (apt install tesseract-ocr, or brew install tesseract on macOS) and
# OCR_TESSDATA_PATH points at its tessdata directory (commonly /usr/share/tesseract-ocr/*/tessdata
# on Linux, or wherever `brew --prefix tesseract` + /share/tessdata resolves on macOS).
OCR_PROVIDER=none
OCR_TESSDATA_PATH=

# Free-tier monthly quotas (Phase 5)
FREE_ANALYSES_PER_MONTH=10
FREE_JD_MATCHES_PER_MONTH=5
FREE_OPTIMIZATIONS_PER_MONTH=10

# Rate limits (per user/IP per minute)
RATE_LIMIT_UPLOAD_PER_MIN=5
RATE_LIMIT_ANALYSIS_PER_MIN=5
RATE_LIMIT_AUTH_PER_MIN=10

PORT=8080
